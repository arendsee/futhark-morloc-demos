module mnist (train)

import tensor-cpp
import tensor-py

-- Futhark runs every matmul (forward, backward, update, predict); Python supplies
-- the data and draws the confusion matrix; morloc owns the epoch loop, threading
-- the weight matrices and dropping the per-step loss it returns.
source Futhark from "kernels.fut" ("train_step", "predict")

train_step
  :: Matrix b 784 F32          -- x: a batch of b input images (784 pixels each)
  -> Matrix b 10 F32           -- y: one-hot labels for the batch (10 classes)
  -> Matrix 784 32 F32         -- w1: input -> hidden weights
  -> Matrix 32 10 F32          -- w2: hidden -> output weights
  -> F32                       -- lr: learning rate for the SGD update
  -> (Matrix 784 32 F32, Matrix 32 10 F32, F32)  -- updated (w1', w2', batch loss)

predict
  :: Matrix b 784 F32          -- x: a batch of b input images (784 pixels each)
  -> Matrix 784 32 F32         -- w1: input -> hidden weights
  -> Matrix 32 10 F32          -- w2: hidden -> output weights
  -> Vector b I32              -- predicted class index (0-9) per image


source Py from "mnist.py"
  ( "train_x" as trainX
  , "train_y" as trainY
  , "test_x" as testX
  , "test_labels" as testLabels
  , "init_w1" as initW1
  , "init_w2" as initW2
  , "plot_confusion" as plotConfusion
  )

trainX        :: Matrix n 784 F32
trainY        :: Matrix n 10 F32
testX         :: Matrix m 784 F32
initW1        :: Matrix 784 32 F32
initW2        :: Matrix 32 10 F32
testLabels    :: Vector m I32

plotConfusion :: Vector m I32 -> Vector m I32 -> Str -> <IO> Str

-- The epoch loop in morloc: apply a Futhark train step, thread the two weight
-- matrices forward, drop the loss field, stop when the budget runs out.
trainLoop
  :: Int                       -- epochs: remaining training steps in the budget
  -> Matrix n 784 F32          -- x: full training set (n input images)
  -> Matrix n 10 F32           -- y: one-hot labels for the training set
  -> Matrix 784 32 F32         -- w1: current input -> hidden weights
  -> Matrix 32 10 F32          -- w2: current hidden -> output weights
  -> (Matrix 784 32 F32, Matrix 32 10 F32)  -- final trained (w1, w2)
trainLoop epochs x y w1 w2
  ? epochs <= 0 = (w1, w2)
  : epochStep (epochs - 1) x y (train_step x y w1 w2 0.1)

epochStep
  :: Int                       -- epochs: remaining steps after this one
  -> Matrix n 784 F32          -- x: full training set (n input images)
  -> Matrix n 10 F32           -- y: one-hot labels for the training set
  -> (Matrix 784 32 F32, Matrix 32 10 F32, F32)  -- train_step result: (w1', w2', loss)
  -> (Matrix 784 32 F32, Matrix 32 10 F32)  -- final trained (w1, w2)
epochStep epochs x y r = trainLoop epochs x y (.0 r) (.1 r)

--' Train the MLP and write a confusion matrix over a held-out test set.
--' return: path to the written plot
train ::
  --' Number of epochs
  Int ->
  --' Output path for the confusion plot
  Str -> <IO> (Matrix 784 32 F32, Matrix 32 10 F32)
train epochs outpath = do
  let final = trainLoop epochs trainX trainY initW1 initW2
  let preds = predict testX (.0 final) (.1 final)
  plotConfusion testLabels preds outpath
  final
